{
  "Jwt": {
    "Issuer": "casino-sim-auth",
    "Audience": "casino-sim-api",
    "Secret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/v1/auth/register"
        },
        "Transforms": [
          { "PathSet": "/api/auth/register" }
        ]
      },
      "auth-login": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/v1/auth/login"
        },
        "Transforms": [
          { "PathSet": "/api/auth/login" }
        ]
      },
      "wallets-my": {
        "ClusterId": "billing-service",
        "Match": {
          "Path": "/api/v1/wallets/my"
        },
        "AuthorizationPolicy": "default"
      },
      "transactions-my": {
        "ClusterId": "billing-service",
        "Match": {
          "Path": "/api/v1/transactions/my"
        },
        "AuthorizationPolicy": "default"
      },
      "games-list": {
        "ClusterId": "gameplay-service",
        "Match": {
          "Path": "/api/v1/games"
        }
      },
      "games-play": {
        "ClusterId": "gameplay-service",
        "Match": {
          "Path": "/api/v1/games/{id}/play"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          { "PathPattern": "/api/games/play" }
        ]
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "billing-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "gameplay-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
