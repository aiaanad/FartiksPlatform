{  
  "Jwt": {  
    "Issuer": "casino-sim-auth",  
    "Audience": "casino-sim-api",  
    "Secret": ""  
  },  
  "ReverseProxy": {  
    "Routes": {  
      "auth-register": {  
        "ClusterId": "user-service",  
        "Match": { "Path": "/api/v1/auth/register" },  
        "Transforms": [ { "PathSet": "/api/auth/register" } ]  
      },  
      "auth-login": {  
        "ClusterId": "user-service",  
        "Match": { "Path": "/api/v1/auth/login" },  
        "Transforms": [ { "PathSet": "/api/auth/login" } ]  
      },  
      "wallets-my": {  
        "ClusterId": "billing-service",  
        "Match": { "Path": "/api/v1/wallets/my" },  
        "AuthorizationPolicy": "default"  
      },  
      "transactions-my": {  
        "ClusterId": "billing-service",  
        "Match": { "Path": "/api/v1/transactions/my" },  
        "AuthorizationPolicy": "default"  
      },  
      "games-list": {  
        "ClusterId": "gameplay-service",  
        "Match": { "Path": "/api/v1/games" }  
      },  
      "games-play": {  
        "ClusterId": "gameplay-service",  
        "Match": { "Path": "/api/v1/games/{id}/play" },  
        "AuthorizationPolicy": "default",  
        "Transforms": [ { "PathPattern": "/api/games/play" } ]  
      },  
  
      "user-catchall": {  
        "ClusterId": "user-service",  
        "Match": { "Path": "/user/{**catch-all}" },  
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]  
      },  
      "billing-catchall": {  
        "ClusterId": "billing-service",  
        "Match": { "Path": "/billing/{**catch-all}" },  
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]  
      },  
      "gameplay-catchall": {  
        "ClusterId": "gameplay-service",  
        "Match": { "Path": "/gameplay/{**catch-all}" },  
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]  
      }  
    },  
    "Clusters": {  
      "user-service": {  
        "Destinations": { "d1": { "Address": "http://fartiks-user-service:8080" } }  
      },  
      "billing-service": {  
        "Destinations": { "d1": { "Address": "http://fartiks-billing-service:8080" } }  
      },  
      "gameplay-service": {  
        "Destinations": { "d1": { "Address": "http://fartiks-gameplay-service:8080" } }  
      }  
    }  
  }  
}
